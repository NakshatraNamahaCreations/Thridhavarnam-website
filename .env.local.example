# Copy to .env.local and fill in real values. Do not commit .env.local.

# Backend base URL — defaults to http://localhost:5000/api if unset.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Razorpay Test Mode public key. Grab the KEY_ID (starts with rzp_test_)
# from https://dashboard.razorpay.com/app/keys. NEVER put KEY_SECRET here —
# it belongs on the backend only (sareeebackend-main/.env).
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
